# ==============================================================================
# GPS CONTROL - VARIABLES DE ENTORNO UNIFICADAS
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (FastAPI + SQLAlchemy + Wialon Gateway)
# Ubicacion: backend/.env
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=cambiar_en_produccion_por_un_hash_seguro_de_minimo_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de Datos (PostgreSQL en produccion, SQLite opcional para local)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/gpscontrol
# DATABASE_URL=sqlite+aiosqlite:///./gpscontrol.db

# Wialon Remote API
WIALON_HOST=https://hst-api.wialon.com
WIALON_TOKEN=tu_token_de_acceso_a_wialon
WIALON_CACHE_TTL_SECONDS=20
WIALON_STALE_TTL_SECONDS=60

# CORS
CORS_ORIGINS=["http://localhost:5173","https://gps-control-pi.vercel.app"]

# Admin inicial (semilla automatica)
FIRST_SUPERUSER_EMAIL=admin@gpscontrol.co
FIRST_SUPERUSER_PASSWORD=password_seguro_admin

# ------------------------------------------------------------------------------
# FRONTEND (React + Vite)
# Ubicacion: frontend/.env
# ------------------------------------------------------------------------------
VITE_API_URL=https://gpscontrol-production.up.railway.app/api/v1
# VITE_API_URL=http://localhost:8000/api/v1
