APP_NAME="GPS Control API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Wialon
WIALON_BASE_URL=https://hst-api.wialon.com/wialon/ajax.html
WIALON_TOKEN=token_here

# Database
# Dev: SQLite (zero setup)
DATABASE_URL=sqlite+aiosqlite:///./gpscontrol.db
# Prod (PostgreSQL): uncomment and set
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/gpscontrol

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed frontend origins (DEP-03)
CORS_ORIGINS=http://localhost:5173

# Admin seed (RF-07)
ADMIN_EMAIL=admin@gpscontrol.co
ADMIN_PASSWORD=change_me_in_production
